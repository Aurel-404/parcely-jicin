# Copy to .env and adjust if needed. Values below are for local development only.

# Host port of the web application (http://localhost:8080)
APP_PORT=8080
# prod = generic error messages, dev = detailed error messages in JSON responses (for debugging)
APP_ENV=prod

# PostgreSQL / PostGIS
DB_NAME=parcely
DB_USER=parcely
# Placeholder, not a secret: the database is reachable only from this machine. Change it if you like.
DB_PASSWORD=change-me
# Host port for connecting with a local client (psql, DBeaver, QGIS); bound to 127.0.0.1 only
DB_PORT_HOST=5433

# Base URL of the RÚIAN exchange format files (empty = https://vdp.cuzk.gov.cz/vymenny_format).
# Change it only if ČÚZK moves the files again.
VFR_BASE_URL=
