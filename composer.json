{
  "name": "parcely/parcely-jicin",
  "description": "Map of all land parcels in the Jičín district (RÚIAN data from ČÚZK) - plain PHP + PostGIS vector tiles.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-xmlreader": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Parcely\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Parcely\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M",
    "cs": "php-cs-fixer check --diff",
    "cs:fix": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true
  }
}
